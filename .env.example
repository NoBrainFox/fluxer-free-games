# --- Required ---------------------------------------------------------------
# Bot token from Fluxer (User Settings > Applications), format {application_id}.{secret}
FLUXER_BOT_TOKEN=
# ID of the text channel where new free games are announced
FLUXER_CHANNEL_ID=

# Contact email sent in the User-Agent of CheapShark API requests, so CheapShark can reach you
CONTACT_EMAIL=

# --- Announcements ----------------------------------------------------------
# Role to ping with each batch of new games: a role name or ID, "everyone", "here", or empty for no ping
MENTION_ROLE=
# Stores to announce, as CheapShark store IDs or names (comma separated), or "all".
# Use the !stores command to see every store and its ID.
STORES=Steam,GOG,Epic Games Store
# How often to check CheapShark, in minutes (clamped to 15-1440)
POLL_INTERVAL_MINUTES=60
# Also announce permanently free-to-play games (normal price 0)
INCLUDE_FREE_TO_PLAY=false
# On the very first start, announce games that are already free (false = only announce future ones)
POST_ON_FIRST_RUN=true

# Delete announcements once the game is no longer free (posts made by older versions are not affected)
DELETE_EXPIRED_POSTS=false
# How long a game must be gone from the free list before its post is deleted, in minutes (min 15)
DELETE_GRACE_MINUTES=120

# --- Commands ---------------------------------------------------------------
COMMAND_PREFIX=!
# Seconds a channel has to wait between commands
COMMAND_COOLDOWN_SECONDS=10

# --- Advanced ---------------------------------------------------------------
# Self-hosted Fluxer: the part of your API URL before /v1, e.g. https://chat.example.com/api
# FLUXER_API_URL=https://api.fluxer.app
# FLUXER_API_VERSION=1
# Only if your instance advertises the wrong gateway, e.g. wss://chat.example.com/gateway
# FLUXER_GATEWAY_URL=
# FLUXER_GATEWAY_INTENTS=0
